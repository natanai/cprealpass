// Biology launcher activation sentinel.
//
// Cyberpunk/REDmod 2.31 ships IconicWeaponModAbilityBase inside the Items
// package. Biology imports that native package explicitly so this standalone
// REDmod tweak does not depend on the source-file-local package context that
// vanilla tweaks receive. The record remains intentionally inert: no gameplay
// record references it. Its only purpose is to provide a REDmod-owned,
// non-persistent truth source that loose Biology REDscript can query.
//
// stackable is inherited from the native GameplayLogicPackage record shape.
// REDlauncher Enable mods OFF therefore removes this REDmod-owned record and
// Items.BiologyLauncherActivationMarker.stackable resolves to the supplied
// default false instead of allowing loose redscript/framework state to keep
// Biology active.
using Items

Items.BiologyLauncherActivationMarker : IconicWeaponModAbilityBase
{
    stackable = true;
}
