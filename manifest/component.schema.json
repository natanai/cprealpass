{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cyberpunk Realism third-party component",
  "type": "object",
  "required": ["id", "name", "author", "sourceUrl", "installedVersion", "archiveSha256", "dependencies", "deployment", "license", "testStatus"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "author": { "type": "string" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "installedVersion": { "type": ["string", "null"] },
    "upstreamVersion": { "type": ["string", "null"] },
    "gameVersion": { "type": "string" },
    "phantomLibertyRequired": { "type": "boolean" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "optionalDependencies": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "configurationFiles": { "type": "array", "items": { "type": "string" } },
    "deployment": { "type": "array", "items": { "type": "string" } },
    "installMethod": { "type": "string" },
    "archiveSha256": { "type": ["string", "null"] },
    "license": { "type": "string" },
    "modificationPermission": { "type": "string" },
    "redistributionPermission": { "type": "string" },
    "attribution": { "type": "string" },
    "saveRisk": { "type": "string" },
    "updateNotes": { "type": "string" },
    "testStatus": { "enum": ["unresearched", "researched", "staged", "tested", "known-good", "rejected"] }
  }
}

