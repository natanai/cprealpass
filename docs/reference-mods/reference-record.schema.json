{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/natanai/cprealpass/docs/reference-mods/reference-record.schema.json",
  "title": "Biology redistribution-safe reference-mod archaeology record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "dependencies", "mappings", "opaqueAreas", "conclusions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "provenance", "selectedIdentities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "provenance": { "type": ["string", "null"], "description": "Public source/home/version provenance only; never a private local path." },
        "selectedIdentities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "description": "Relative identity path only." },
              "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["referenceArea", "mechanism", "nativeContract", "biologyOwnedSeam", "validation"],
        "properties": {
          "referenceArea": { "type": "string", "minLength": 1 },
          "mechanism": {
            "type": "string",
            "enum": ["redscript-hook-wrap", "redscript-hook-replace", "redscript-additive", "tweakxl", "redmod-tweak", "archive-resource-replacement", "framework-native-extension", "other-derived", "unknown"]
          },
          "referencePathIdentity": { "type": ["string", "null"], "description": "Relative path plus hash reference; no copied implementation body." },
          "nativeContract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gameVersion", "controllerOrSystem", "widgetOrResource"],
            "properties": {
              "gameVersion": { "type": "string", "minLength": 1 },
              "controllerOrSystem": { "type": ["string", "null"] },
              "widgetOrResource": { "type": ["string", "null"] }
            }
          },
          "biologyOwnedSeam": { "type": "string", "minLength": 1 },
          "validation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "opaqueAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pathIdentity", "reason", "nextEvidence"],
        "properties": {
          "pathIdentity": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "nextEvidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conclusions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
